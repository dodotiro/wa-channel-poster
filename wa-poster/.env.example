# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env asli.

# Token rahasia untuk header X-Token pada API sidecar.
# Buat yang acak, mis. dengan: openssl rand -hex 24
POSTER_TOKEN=<redacted>

# Nomor WhatsApp yang akan di-pairing sebagai pengirim (format internasional,
# tanpa + dan tanpa spasi). Dipakai untuk pairing dengan kode 8 karakter.
PAIR_PHONE=628xxxxxxxxxx

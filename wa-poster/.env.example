# Copy this file to .env and fill in the values. Never commit the real .env.

# Secret token for the X-Token header on the sidecar API.
# Make it random, for example with openssl rand -hex 24
POSTER_TOKEN=<redacted>

# WhatsApp number that will be paired as the sender, in international
# format without a plus sign or spaces. Used for pairing with the
# 8 digit code.
PAIR_PHONE=628xxxxxxxxxx

# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env asli.

# Port web pengirim
PORT=8090

# Password login halaman web
WEB_PASSWORD=ganti-dengan-password-anda

# Token sidecar wa-poster — HARUS sama persis dengan POSTER_TOKEN di wa-poster/.env
POSTER_TOKEN=<redacted>

# JID Saluran WhatsApp tujuan utama (format: 120363xxxxxxxxxx@newsletter)
CHANNEL_JID=120363xxxxxxxxxx@newsletter

# JID nomor pengirim sendiri (untuk opsi tujuan "Nomor sendiri (tes)")
SELF_JID=628xxxxxxxxxx@s.whatsapp.net

# Copy this file to .env and fill in the values. Never commit the real .env.

# Port of the sender web page
PORT=8090

# Password for the web login page
WEB_PASSWORD=change-this-password

# Sidecar token. It must match POSTER_TOKEN in wa-poster/.env exactly.
POSTER_TOKEN=<redacted>

# Target Channel JID, in the form 120363xxxxxxxxxx@newsletter
CHANNEL_JID=120363xxxxxxxxxx@newsletter

# The sender's own JID, used by the optional own number destination
SELF_JID=628xxxxxxxxxx@s.whatsapp.net
